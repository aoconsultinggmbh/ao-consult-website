# ---------------------------------------------------------------------------
# Servereinstellungen fuer den echten Webserver (Apache, z. B. All-Inkl).
# Auf der GitHub-Vorschau wird diese Datei ignoriert - sie wirkt erst,
# wenn die Seite beim Hoster liegt.
#
# VOR DEM LIVEGANG: die Umleitung unten freischalten (Raute entfernen) und
# DOMAIN durch die echte Domain ersetzen. Vorher bitte nicht - eine falsche
# Umleitung macht die Seite unerreichbar.
# ---------------------------------------------------------------------------

RewriteEngine On

# --- Uebergangsadresse des Hosters nicht umleiten -------------------------
# Vor dem Domain-Umzug ist die Seite nur unter der Adresse
# <domain>.<konto>.kasserver.com erreichbar. Ohne diese Ausnahme wuerde die
# Umleitung darunter jeden Aufruf sofort wieder auf die ALTE Seite schicken,
# und der Test vor dem Livegang waere unmoeglich.
# Die Regel bleibt auch nach dem Livegang stehen: sie stoert nicht und
# rettet den naechsten Test.
RewriteCond %{HTTP_HOST} \.kasserver\.com$ [NC]
RewriteRule ^ - [L]

# --- Immer https und immer ohne www (erst am Livegang-Tag freischalten) -----
# ao-consult.de lief schon immer ohne www, Google kennt die Seite so.
# Freischalten erst, wenn das Zertifikat fuer ao-consult.de UND www aktiv ist.
# RewriteCond %{HTTPS} !=on [OR]
# RewriteCond %{HTTP_HOST} ^www\. [NC]
# RewriteRule ^(.*)$ https://ao-consult.de/$1 [R=301,L]

# --- Alte Adressen der WordPress-Seite dauerhaft umleiten ------------------
# Damit Google-Platzierungen, Lesezeichen und Links in alten Mails weiter
# funktionieren. Relative Ziele, damit das auch auf der Testadresse klappt.
RedirectMatch 301 ^/kontakt/?$ /kontakt.html
RedirectMatch 301 ^/fallstudien/?$ /fallstudien.html
RedirectMatch 301 ^/fallstudien/zahnarztpraxis-dr-sandro-stroessner/?$ /fallstudie-zahnarztpraxis-stroessner.html
RedirectMatch 301 ^/fallstudien/kimmel-zahntechnik-gmbh/?$ /fallstudie-kimmel-zahntechnik.html
RedirectMatch 301 ^/fallstudien/zahnarztpraxis-kindler-und-kollegen/?$ /fallstudie-zahnarztpraxis-kindler.html
RedirectMatch 301 ^/fallstudien/teamziereis-gmbh/?$ /fallstudie-teamziereis.html
RedirectMatch 301 ^/fidelius-mvz/?$ /fallstudie-fidelius-mvz.html
RedirectMatch 301 ^/optident-mvz/?$ /fallstudie-optident-mvz.html
RedirectMatch 301 ^/ihr-erstgespraech/?$ /ihr-erstgespraech.html
RedirectMatch 301 ^/ihr-beratungsgespraech/?$ /ihr-beratungsgespraech.html
RedirectMatch 301 ^/sos/?$ /sos.html
RedirectMatch 301 ^/empfehlungsprogramm/?$ /empfehlungsprogramm.html
RedirectMatch 301 ^/partner/?$ /partner.html
RedirectMatch 301 ^/(team|ueber-uns)/?$ /ueber-uns.html
RedirectMatch 301 ^/impressum/?$ /impressum.html
RedirectMatch 301 ^/(datenschutz|datenschutzerklaerung)/?$ /datenschutz.html
RedirectMatch 301 ^/agb/?$ /agb.html
RedirectMatch 301 ^/hinweis-zur-gleichstellung/?$ /gleichstellung.html
RedirectMatch 301 ^/danke/?$ /danke.html
RedirectMatch 301 ^/herzlich-willkommen/?$ /willkommen/
RedirectMatch 301 ^/onboarding/?$ /

ErrorDocument 404 /index.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# MultiViews aus: sonst beantwortet Apache /kontakt/ mit kontakt.html und die
# Umleitungen der alten Adressen greifen nicht (gemessen auf All-Inkl, 06.10.2026)
Options -Indexes -MultiViews

<IfModule mod_headers.c>
  # HTML nie zwischenspeichern: sonst sehen Besucher (und wir beim
  # Testen) nach einer Aenderung stundenlang die alte Seite.
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
